# 이 파일을 복사해서 .env.local 로 이름을 바꾸고, 값을 채워주세요.
#
#   .env.local 은 절대 GitHub에 올라가면 안 됩니다.
#   .gitignore 에 이미 넣어뒀습니다.


# ────────────────────────────────────────────────────────────
# 1. 표를 만들고 자료를 넣을 때 쓰는 값  (npm run db:* 가 씁니다)
# ────────────────────────────────────────────────────────────
#
# 여기가 제일 중요합니다. anon 키로는 표를 만들 수 없어요.
# 표를 만들려면 데이터베이스 비밀번호가 들어간 접속 문자열이 필요합니다.
#
# 찾는 법:
#   Supabase → 내 프로젝트 → 화면 위쪽 [Connect] 버튼
#   → Session pooler 항목의 URI 를 복사
#   → [YOUR-PASSWORD] 자리에 프로젝트 만들 때 정한 비밀번호를 넣기
#
# 비밀번호를 잊으셨으면 Settings → Database 에서 새로 정할 수 있습니다.
#
# ⚠ 비밀번호에 @ : / ? # 같은 글자가 있으면 URL 인코딩이 필요합니다.
#   번거로우니 비밀번호를 영문+숫자로 새로 바꾸시는 편이 빠릅니다.

SUPABASE_DB_URL=postgresql://postgres.abcdefghijklmn:여기에비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres


# ────────────────────────────────────────────────────────────
# 2. 사이트가 쓰는 값  (3회차부터. 지금은 없어도 됩니다)
# ────────────────────────────────────────────────────────────
#
# Supabase → Settings → API Keys 에서 복사합니다.
# 이 두 개는 브라우저에 그대로 노출되는 값이라 비밀이 아닙니다.
# 그래도 GitHub에는 올리지 않습니다. 6회차에 Vercel 화면에 따로 넣어요.

NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 키 이름이 두 가지입니다. 프로젝트를 언제 만들었느냐에 따라 달라요.
#
#   sb_publishable_...  ← 새 방식. Publishable key
#   eyJhbGciOi...       ← 예전 방식. anon key
#
# 하는 일은 같습니다. 화면에 보이는 이름 그대로 쓰시면 됩니다.
# 4회차에 AI에게 시킬 때도 내 키가 어느 쪽인지 알려주세요.


# ────────────────────────────────────────────────────────────
# 넣지 않는 것
# ────────────────────────────────────────────────────────────
#
# service_role 키는 여기에 넣지 마세요.
# 이 프로젝트에서는 쓸 일이 없습니다. 그 키는 모든 권한을 통과하는 열쇠라,
# 실수로 사이트 코드에 섞이면 누구나 데이터를 다 지울 수 있게 됩니다.
